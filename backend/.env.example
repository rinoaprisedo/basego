APP_ENV=development
APP_PORT=8800
FRONTEND_URL=http://localhost:8801,http://localhost:8802

DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5401
DB_USER=postgres
DB_PASS=password
DB_NAME=baseadmin

REDIS_HOST=localhost
REDIS_PORT=6301
REDIS_PASS=
REDIS_DB=0

SESSION_MAX_AGE=86400
SESSION_MAX_CONCURRENT=3

STORAGE_PATH=./storage/uploads
STORAGE_MAX_SIZE=2097152

LOG_CLEANUP_DAYS=90
RATE_LIMIT_LOGIN=5
RATE_LIMIT_LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_API=100

# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For is trusted for the
# client IP (rate limiting, login lockout, audit log). Leave EMPTY unless the
# API runs behind a reverse proxy/load balancer you control — otherwise a client
# can spoof the header and bypass the limits.
TRUSTED_PROXIES=

# Used only by `./baseadmin seed`. Leave empty to generate a random password
# (printed once in the seed log). Must satisfy the password policy.
SEED_ADMIN_PASSWORD=

# Performance / abuse protection
# Seconds identity+permission lookups are cached in-process (0 = off). A role or
# permission edit flushes the cache on the instance that handled it; other
# instances converge within this TTL. Suspension/deletion are always immediate.
AUTHZ_CACHE_TTL_SECONDS=5
# Failed logins per ACCOUNT (from any IP, 15 min window) before it is locked for
# RATE_LIMIT_LOGIN_LOCKOUT_MINUTES. 0 disables. Note: lets an attacker lock a
# known email out for that period.
RATE_LIMIT_LOGIN_ACCOUNT=10
# Max simultaneous bcrypt operations (default: half the CPU cores).
BCRYPT_MAX_CONCURRENT=

